#!/system/bin/bash
conf="/data/local/tmp/PowerSentinel/PowerSentinel.conf"
. "$(dirname "$0")/PowerSentinel-config.sh"
. "$(dirname "$0")/PowerSentinel-detect.sh"
. "$(dirname "$0")/PowerSentinel-policy.sh"
. "$(dirname "$0")/PowerSentinel-capabilities.sh"
. "$(dirname "$0")/PowerSentinel-apppolicy.sh"
. "$(dirname "$0")/PowerSentinel-actions.sh"
. "$(dirname "$0")/PowerSentinel-journal.sh"
. "$(dirname "$0")/PowerSentinel-alertbridge.sh"
. "$(dirname "$0")/PowerSentinel-energylog.sh"
. "$(dirname "$0")/PowerSentinel-appwatch.sh"
. "$(dirname "$0")/PowerSentinel-state.sh"
. "$(dirname "$0")/PowerSentinel-events.sh"
declare -a active_events
# When each currently-active event started (unix seconds), keyed by
# event name - populated alongside active_events itself (see
# handle_event() in events.sh) so the WebUI can show "activo desde
# HH:MM" instead of just "activo".
declare -gA active_event_start_ts=()

# BUG FIX (found by an external code review, not independently
# reproduced but cheap and safe enough to fix as defense-in-depth
# regardless): the watchdog in service.sh only ever checked `pgrep -f
# PowerSentineld` before deciding whether to launch another instance -
# no lock, no PID file, nothing atomic about that decision. A daemon
# that toggles CPU governors, core online state, WiFi, and system
# properties genuinely shouldn't risk two instances existing at once,
# even if the exact race window couldn't be pinned down concretely.
#
# Writing the PID here, as early as possible in the process's life
# (before migration, capability probing, or anything else that takes
# real time), means the watchdog's own check (see service.sh) has an
# authoritative, promptly-updated record of who's actually running -
# and since `PowerSentinelctl reload`'s `exec "$0"` replaces the
# process image in place without changing the PID, this file stays
# correct straight through a reload with no extra bookkeeping needed.
: "${pid_file:=/data/local/tmp/PowerSentinel/PowerSentineld.pid}"
mkdir -p "$(dirname "$pid_file")" 2>/dev/null
echo "$$" > "$pid_file" 2>/dev/null
chmod 600 "$pid_file" 2>/dev/null
declare -a cpus
declare -a cpu_freqs
declare -a hp_cpus
declare -a lp_cpus
declare -a lp_govs
declare RFKILL_CMD="" # Global variable for the correct rfkill command
cpu_base_path="/sys/devices/system/cpu"

# Helpers and one time things

getconf() {
  # Compatibility wrapper: callers keep the existing interface while all
  # global reads go through the centralized configuration cache.
  config_get "$1" "${2-}"
}

# SECURITY: creates/repairs the control file the webui/PowerSentinelctl write
# commands into. Any world-writable directory (like /data/local/tmp
# itself) lets an unprivileged app pre-create a file with our exact name
# before we do, keeping ownership/permissions of their choosing forever
# after - so if a pre-existing ctl_file isn't owned by root, it's treated
# as compromised and replaced with a fresh, root-only one instead of
# trusting whatever is in it.
ensure_ctl_file() {
  local f="$1"
  local owner
  mkdir -p "$(dirname "$f")" 2>/dev/null
  if [ -e "$f" ]; then
    owner="$(stat -c '%u' "$f" 2>/dev/null)"
    if [ "$owner" != "0" ]; then
      log_msg 1 "ctl_file $f is not owned by root (uid $owner) - recreating it"
      rm -f "$f"
    fi
  fi
  [ -e "$f" ] || : > "$f"
  chmod 600 "$f" 2>/dev/null
}

# get_night_times/is_night_now, get_thermal_threshold/is_thermal_now, and
# the adaptive pressure engine (compute_pressure_score/
# pressure_tier_for_score) now live in PowerSentinel-policy.sh - they're
# pure decisions (given detected state + config, what should be active),
# not actions, so they moved out alongside detect.sh in the same
# architecture pass.

# Optional charge limiter: stops charging once the battery reaches
# $charge_limit%, resumes 5% below it (hysteresis, same idea as the
# thermal profile above). Entirely opt-in - both charge_limit and
# charge_limit_node must be set, since the sysfs path that actually
# controls charging varies by device/kernel and there's no universal
# one. Writes "0"/"1" (the most common convention for a
# "charging_enabled"-style node); if the path is wrong the write simply
# fails silently rather than touching anything else. Left in the daemon
# itself (not moved to policy.sh) since it both decides *and* acts
# (writes to charge_limit_node directly) - untangling that mix is
# action-extraction work for a later phase, not this one.
was_charge_paused="false"
check_charge_limit() {
  local charge_limit charge_limit_node level charging
  charge_limit=$(getconf charge_limit 0)
  charge_limit_node=$(getconf charge_limit_node "")
  [ "$charge_limit" -gt 0 ] 2>/dev/null || return
  [ -n "$charge_limit_node" ] && [ -w "$charge_limit_node" ] || return

  level="$DETECT_BATTERY_LEVEL"
  charging="$DETECT_BATTERY_CHARGING"

  if [ "$charging" = "true" ] && [ "$level" -ge "$charge_limit" ]; then
    if [ "$was_charge_paused" != "true" ]; then
      echo 0 > "$charge_limit_node" 2>/dev/null && was_charge_paused="true" && log_msg 2 "Charge limit reached (${level}%) - pausing charging"
    fi
  elif [ "$was_charge_paused" = "true" ] && { [ "$charging" != "true" ] || [ "$level" -le "$((charge_limit - 5))" ]; }; then
    echo 1 > "$charge_limit_node" 2>/dev/null && was_charge_paused="false" && log_msg 2 "Resuming charging (${level}%)"
  fi
}

# notif() has been replaced by emit() (PowerSentinel-journal.sh) +
# alert_dispatch() (PowerSentinel-alertbridge.sh) - see those files for
# the full rationale. The base64-encoding security measure this
# function used lives on in alert_dispatch(), which is now the only
# place that actually calls `su -c ... cmd notification post`.

log_msg() {
  case $1 in
    1)
      log_lvl="[INFO]" ;;
    2)
      log_lvl="[VERBOSE]" ;;
    3)
      log_lvl="[DEBUG]" ;;
  esac
  if [ "$log_level" -ge "$1" ]; then
    echo "$(date +"%m-%d-%Y %H:%M:%S") $log_lvl $2" >> "$log_file"
  fi
}

migrate() {
  log_msg 2 "No event blocks found in the config - migrating to v2"
  log_msg 1 "Migrating to v2 config"
  # start with base conf values
  # delay, version, log_file, log_level
  echo "version=2" > "$conf-v2"
  ctl_file=$(getconf ctl_file "")
  if [ ! -z "$ctl_file" ]; then
    echo "ctl_file=$ctl_file" >> "$conf-v2"
  fi
  delay="$(getconf delay 3)"
  echo "delay=$delay" >> "$conf-v2"
  log_file="$(getconf log_file "$(dirname "$conf")/PowerSentinel.log")"
  echo "log_file=$log_file" >> "$conf-v2"
  log_level="$(getconf log_level 1)"
  echo "log_level=$log_level" >> "$conf-v2"
  # newline for clarity
  echo >> "$conf-v2"

  # start with figuring out the trigger,
  # then write values over.
  event_blocks=("charging" "screen_off")
  # events:
  # charging, screen_off, boot,
  # manual, low_power
  trigger="$(getconf trigger auto)"
  case "$trigger" in
    auto)
      event_blocks+=("manual" "boot")
      # start event block
      echo "low_power={" >> "$conf-v2"
      # keep_on_charge can be used if
      # you want the settings to persist
      # when the device is plugged in
      echo "keep_on_charge=$(getconf keep_on_charge true)" >> "$conf-v2"
      ;;
    boot)
      event_blocks+=("low_power" "manual")
      echo "boot={" >> "$conf-v2"
      # quit is a new option that can only
      # be used in a boot block. it exits the daemon
      # after making changes to keep CPU cycles to a minimum
      echo "quit=false" >> "$conf-v2"
      ;;
    manual)
      event_blocks+=("boot" "low_power")
      echo "on_start={" >> "$conf-v2"
      ;;
  esac

  # copy values over
  echo "handle_cores=$(getconf handle_cores false)" >> "$conf-v2"
  echo "disable_cores=$(getconf disable_cores false)" >> "$conf-v2"
  echo "handle_apps=$(getconf handle_apps false)" >> "$conf-v2"
  echo "allowlist=$(getconf allowlist /sdcard/PowerSentinel/apps.allow)" >> "$conf-v2"
  echo "denylist=$(getconf denylist /sdcard/PowerSentinel/apps.deny)" >> "$conf-v2"
  echo "handle_gms=$(getconf handle_gms false)" >> "$conf-v2"
  echo "handle_proc=$(getconf handle_proc false)" >> "$conf-v2"
  echo "proc_file=$(getconf proc_file /sdcard/PowerSentinel/proc.list)" >> "$conf-v2"
  echo "low_ram=$(getconf low_ram false)" >> "$conf-v2"
  echo "doze=$(getconf doze false)" >> "$conf-v2"
  echo "kill_wifi=$(getconf kill_wifi false)" >> "$conf-v2"
  echo "}" >> "$conf-v2"
  echo >> "$conf-v2"

  # write remaining event blocks
  for event in ${event_blocks[@]}; do
    echo -e "$event={\n}\n" >> "$conf-v2"
  done

  # remove the version string and make backup
  sed -i '/^version=2/d' "$conf" # remove v2
  mv "$conf" "$conf-v1"
  # make new conf take effect
  mv "$conf-v2" "$conf"
  log_msg 1 "Migration complete!"
}

# auto_map_cores() and find_rfkill_command() now live in
# PowerSentinel-detect.sh - both are one-time, side-effect-free hardware
# detection (CPU topology, available rfkill mechanism), not actions.

update_status() {
  status_file="/data/local/tmp/PowerSentinel/PowerSentinel.status"
  echo -n > "$status_file"
  # CPU Map
  for i in ${!cpus[@]}; do
    core="${cpus[$i]}"
    core_list+=( "$core" )
    #is it in powersave
    core="${core_list[$i]}"
    if [ "$(cat $cpu_base_path/$core/cpufreq/scaling_governor)" = "powersave" ]; then
      tmp_var="powersave"
    fi
    # is it disabled
    if [ "$(cat $cpu_base_path/$core/online)" = "0" ]; then
      tmp_var="offline"
    fi
    core_status+=( "${tmp_var:-online}" )
    unset tmp_var
  done

  # wifi
  if [ -n "$RFKILL_CMD" ]; then
    wifi=$($RFKILL_CMD list wifi | grep "Soft" | cut -d' ' -f3)
  fi
  if [ "$wifi" = "yes" ]; then
    wifi="disabled"
  else
    wifi="enabled"
  fi

  # Doze
  unset doze
  light="$(dumpsys deviceidle get light)"
  deep="$(dumpsys deviceidle get deep)"
  if [ "$light" = "IDLE" ]; then
    doze="light"
  elif [ "$deep" = "IDLE" ]; then
    doze="deep"
  else
    doze="inactive"
  fi

  for i in ${!core_list[@]}; do
    core="${core_list[$i]}"
    cur_freq="$(cat "$cpu_base_path/$core/cpufreq/scaling_cur_freq" 2>/dev/null)"
    max_freq="$(cat "$cpu_base_path/$core/cpufreq/cpuinfo_max_freq" 2>/dev/null)"
    if [ -n "$cur_freq" ] && [ -n "$max_freq" ]; then
      echo "${core_list[$i]}: ${core_status[$i]} freq=${cur_freq}/${max_freq}" >> "$status_file"
    else
      echo "${core_list[$i]}: ${core_status[$i]}" >> "$status_file"
    fi
  done
  unset core_list core_status
  echo "Low RAM: $(getprop ro.config.low_ram)" >> "$status_file"
  echo "WiFi: $wifi" >> "$status_file"
  echo "Doze: $doze" >> "$status_file"
  load="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)"
  [ -n "$load" ] && echo "Load: $load" >> "$status_file"
  unset doze wifi load

  # Battery. update_status() can run at any point during an event
  # transition (it's called from both enable_pwr_save and
  # disable_pwr_save), not only once per poll cycle, so it refreshes
  # detection itself here rather than trusting whatever the main loop's
  # own detect_refresh last captured - the WebUI's Estado tab reads this
  # file, and stale battery data there would be worse than one extra
  # dumpsys call on a state change.
  detect_refresh
  energylog_sample
  if [ -n "$DETECT_BATTERY_LEVEL" ]; then
    echo "Battery: level=${DETECT_BATTERY_LEVEL} temp=${DETECT_BATTERY_TEMP_RAW} voltage=${DETECT_BATTERY_VOLTAGE} charging=${DETECT_BATTERY_CHARGING}" >> "$status_file"
  fi

  # Currently-active events (empty list if none), for the WebUI to show
  # "what's applied right now" instead of just the aggregate savings %.
  echo "ActiveEvents: ${active_events[*]}" >> "$status_file"

  # How many apps are unconditionally protected right now (device
  # default dialer/SMS/emergency + anything already exempt from
  # battery optimization) - for the WebUI to show simple reassurance
  # ("N apps are always protected") without needing to expose the
  # actual package list, which isn't particularly meaningful to
  # someone who didn't choose those apps themselves.
  echo "CriticalAppsCount: ${#DETECT_CRITICAL_APPS[@]}" >> "$status_file"

  # Real device identification (ro.product.* - standard, stable Android
  # build properties, not a dumpsys parse) and the already-computed
  # Capability Manager results (PowerSentinel-capabilities.sh), so the
  # WebUI can show what this specific device actually is and actually
  # supports - "detección automática de hardware" from the roadmap -
  # instead of every user seeing the same generic warnings regardless
  # of whether they're actually relevant to their device.
  echo "Manufacturer: $(getprop ro.product.manufacturer 2>/dev/null)" >> "$status_file"
  echo "Model: $(getprop ro.product.model 2>/dev/null)" >> "$status_file"
  echo "Capabilities: $(capabilities_summary)" >> "$status_file"

  # "¿Qué está haciendo ahora?" / dashboard roadmap items: the real
  # pressure score AND its breakdown by contributing factor (only
  # meaningful while the adaptive engine is actually the thing driving
  # decisions), and when each currently-active event started - both
  # needed to explain, in plain language, what's active and why,
  # instead of a technical tier number with no context.
  if [ "$(config_get adaptive_mode false)" = "true" ]; then
    echo "PressureScore: $(compute_pressure_score)" >> "$status_file"
    echo "PressureBreakdown: $(pressure_breakdown)" >> "$status_file"
    echo "PressureThresholds: $(getconf adaptive_tier1_threshold 20) $(getconf adaptive_tier2_threshold 45) $(getconf adaptive_tier3_threshold 70)" >> "$status_file"
  fi
  if [ "${#active_event_start_ts[@]}" -gt 0 ]; then
    local _ts_json
    _ts_json="$({
      for _ts_name in "${!active_event_start_ts[@]}"; do
        "$JQ" -cn --arg n "$_ts_name" --argjson ts "${active_event_start_ts[$_ts_name]}" '{($n): $ts}' 2>/dev/null
      done
    } | "$JQ" -cs 'add' 2>/dev/null)"
    echo "ActiveEventStartTimes: ${_ts_json:-\{\}}" >> "$status_file"
  fi
  echo "ActiveMechanisms: $(active_mechanisms_snapshot)" >> "$status_file"
}

# read_config() (V1) removed - see below, v1 support has been
# removed entirely: every install auto-migrates to v2 on first
# boot (see the migrate() trigger further down), so there is no
# longer a code path that ever runs in v1 mode.



# Action stuff

enable_pwr_save() {
  action_apps_apply
  action_gms_apply
  action_proc_apply
  action_low_ram_apply
  action_wifi_apply
  action_doze_apply
  action_cores_apply

  update_status
}

disable_pwr_save() {
  action_cores_undo
  action_doze_undo
  action_wifi_undo
  action_apps_undo
  action_gms_undo
  action_proc_undo
  action_low_ram_undo

  update_status
}

# handle_event() now lives in PowerSentinel-events.sh - the Event
# Manager: event locking/active_events bookkeeping, field resolution,
# and dispatch to enable_pwr_save/disable_pwr_save.


init_v2() {

adaptive_mode="$(getconf adaptive_mode false)"

# Undo whatever the previous run left active before doing anything
# else - see PowerSentinel-state.sh for the full rationale (a crash or
# unclean reboot must not leave the daemon believing it's starting from
# a clean baseline when the system itself might not be).
state_reconcile

handle_event boot 1

if [ "$adaptive_mode" != "true" ]; then
  charging="$(is_device charging)"
  if [ "$charging" = "true" ]; then
    handle_event charging 1
  fi
  was_charging="$charging"
  low_power="$(is_device low_power)"
  if [ "$low_power" = "true" ]; then
    handle_event low_power 1
  fi
  was_low_power="$low_power"
  screen_on="$(is_device screen)"
  # here we invert because we only want to
  # do something if the screen is off
  if [ "$screen_on" = "false" ]; then
    handle_event screen_off 1
  fi
  was_screen_on="$screen_on"

  get_night_times
  night_now="$(is_night_now)"
  if [ "$night_now" = "true" ]; then
    handle_event night 1
  fi
  was_night="$night_now"

  was_thermal="false"
  get_thermal_threshold
  thermal_now="$(is_thermal_now)"
  if [ "$thermal_now" = "true" ]; then
    handle_event thermal 1
  fi
  was_thermal="$thermal_now"
else
  was_adaptive_tier=0
  adaptive_score="$(compute_pressure_score)"
  adaptive_tier="$(pressure_tier_for_score "$adaptive_score")"
  log_msg 2 "Adaptive mode enabled - initial score=$adaptive_score tier=$adaptive_tier"
  if [ "$adaptive_tier" -gt 0 ]; then
    handle_event "adaptive_tier${adaptive_tier}" 1
  fi
  was_adaptive_tier="$adaptive_tier"
fi

while true; do

  # One shared snapshot of battery/load state for everything this cycle
  # reads (compute_pressure_score, is_thermal_now, check_charge_limit) -
  # see PowerSentinel-detect.sh for why this replaced four independent
  # dumpsys calls.
  detect_refresh

  # Change-triggered energy log: a no-op most cycles (writes only when
  # battery level or temperature actually moved) - see
  # PowerSentinel-energylog.sh for the full rationale.
  energylog_sample

  # Observational background-CPU watch: internally throttled to once
  # every $APPWATCH_INTERVAL_S, and only does anything while the screen
  # is off - see PowerSentinel-appwatch.sh.
  appwatch_check

  # Check for command
  cmd="$(cat $ctl_file)"
  cmd_event=$(echo "$cmd" | cut -d' ' -f2)
  cmd=$(echo "$cmd" | cut -d' ' -f1)
  echo > "$ctl_file"
  case $cmd in
    reload)
      # reload is for top level config opts
      for i in ${!active_events[@]}; do
        handle_event "${active_events[$i]}" 0
      done
      log_msg 2 "Reloading the config"
      exec "$0"
      ;;
    start)
      if [ ! "$cmd_event" ]; then
        log_msg 1 "The start command was received. Starting manual event"
        handle_event manual 1
      else
        log_msg 1 "The start command was received. Attempting to start $cmd_event"
        handle_event "$cmd_event" 1
      fi
      ;;
    stop)
      if [ ! "$cmd_event" ]; then
        log_msg 1 "The stop command was received. Stopping manual event"
        handle_event manual 0
      else
        log_msg 1 "The stop command was received. Attempting to stop $cmd_event"
        for i in ${!active_events[@]}; do
          if [ "${active_events[$i]}" = "$cmd_event" ]; then
            handle_event "${active_events[$i]}" 0
          fi
        done
      fi
      ;;
    pause)
      until [ "$resume" = "resume" ]; do
        sleep "$delay"
        resume="$(cat $ctl_file)"
      done ;;
    safe)
      log_msg 1 "Entered Safe Mode"
      config_set_global safemode true
      for i in ${!active_events[@]}; do
        handle_event "${active_events[$i]}" 0
      done
      for pkg in $(pm list packages | cut -d: -f2-); do
        pm unsuspend "$pkg"
      done
      emit safemode critical "Safe Mode is Active"
      # BUG FIX: this loop had no sleep at all (unlike the near-identical
      # "pause" command handler above it, which does) - a pre-existing
      # bug dating back to before this project's PowerSentinel identity,
      # found during a full-codebase audit. It span-checked the control
      # file as fast as the CPU would allow for as long as safe mode
      # remained active - a battery-saving module burning a full CPU
      # core precisely while its own emergency/escape-hatch mode was
      # engaged.
      until [ "$ready" = "resume" ]; do
        sleep "$delay"
        ready="$(cat $ctl_file)"
      done
      log_msg 1 "Resume command received. Safe Mode Exited."
      config_set_global safemode false
      exec "$0"
      ;;
    *)
      :
      ;;
  esac

  # check charging state
  if [ "$adaptive_mode" != "true" ]; then
    charging=$(is_device charging)
    if [ "$was_charging" != "" ]; then
      if [ "$charging" != "$was_charging" ]; then
        log_msg 2 "Charging event was triggered"
        if [ "$charging" = "true" ]; then
          handle_event charging 1
        else
          handle_event charging 0
        fi
      fi
    fi
    was_charging="$charging"

    # check low_power state
    low_power=$(is_device low_power)
    if [ "$was_low_power" != "" ]; then
      if [ "$low_power" != "$was_low_power" ]; then
        log_msg 2 "Low Power event was triggered"
        if [ "$low_power" = "true" ]; then
          handle_event low_power 1
        else
          handle_event low_power 0
        fi
      fi
    fi
    was_low_power="$low_power"

    # check screen change
    screen_on=$(is_device screen)
    if [ "$was_screen_on" != "" ]; then
      if [ "$screen_on" != "$was_screen_on" ]; then
        log_msg 2 "Screen change was detected"
        # here we invert because we only want to
        # do something if the screen is off
        if [ "$screen_on" = "false" ]; then
          handle_event screen_off 1
        else
          handle_event screen_off 0
        fi
      fi
    fi
    was_screen_on="$screen_on"

    # check night profile (time-of-day, independent of any device state)
    night_now="$(is_night_now)"
    if [ "$was_night" != "" ]; then
      if [ "$night_now" != "$was_night" ]; then
        log_msg 2 "Night profile boundary crossed"
        if [ "$night_now" = "true" ]; then
          handle_event night 1
        else
          handle_event night 0
        fi
      fi
    fi
    was_night="$night_now"

    # check thermal profile (temperature-based, independent of any device state)
    thermal_now="$(is_thermal_now)"
    if [ "$thermal_now" != "$was_thermal" ]; then
      log_msg 2 "Thermal profile boundary crossed"
      if [ "$thermal_now" = "true" ]; then
        handle_event thermal 1
      else
        handle_event thermal 0
      fi
    fi
    was_thermal="$thermal_now"
  else
    # Adaptive mode: recompute the pressure score every cycle and move
    # to whichever tier it maps to - only the boundary crossing itself
    # (not every unchanged score) triggers a handle_event call, exactly
    # like the classic checks above only escalate/de-escalate on a
    # real transition.
    adaptive_score="$(compute_pressure_score)"
    adaptive_tier="$(pressure_tier_for_score "$adaptive_score")"
    if [ "$adaptive_tier" != "$was_adaptive_tier" ]; then
      log_msg 2 "Adaptive tier changed: $was_adaptive_tier -> $adaptive_tier (score=$adaptive_score)"
      [ "$was_adaptive_tier" -gt 0 ] && handle_event "adaptive_tier${was_adaptive_tier}" 0
      [ "$adaptive_tier" -gt 0 ] && handle_event "adaptive_tier${adaptive_tier}" 1
    fi
    was_adaptive_tier="$adaptive_tier"
  fi

  check_charge_limit

  sleep "$delay"
done
}

# init_v1() removed - v1 support has been removed entirely.


# START

# setup config - every install migrates to v2 on first boot, see the
# migrate() trigger below

[ ! -d /data/local/tmp/PowerSentinel/ ] && mkdir /data/local/tmp/PowerSentinel/

# Sanity-check that jq actually runs on this device before relying on
# it for the config migration and every JSON read/write from here on -
# if it doesn't (wrong CPU architecture, a corrupted/incompletely
# extracted binary, a permission or SELinux denial), every one of those
# would otherwise fail silently, eventually surfacing as a confusing
# "could not migrate config to v2" FATAL exit with no indication of
# WHY. This gives a specific, actionable message instead, as early as
# possible.
if ! echo '{}' | "$JQ" -e . >/dev/null 2>&1; then
  msg="FATAL: jq ($JQ) does not appear to work on this device - cannot read or write configuration. Check that the file exists, is executable (chmod 755), and matches your device's CPU architecture (this build is arm64)."
  echo "$msg" >&2
  log -t PowerSentinel "$msg" 2>/dev/null
  exit 1
fi

if [ ! -s "$conf" ]; then
  cat << EOF > "$conf"
# trigger
# auto|boot|manual
trigger=auto

# this will make version 2 the default (Mwahahahahaha)
version=2

# log file
log_file=/sdcard/PowerSentinel.log

# log level
log_level=1

# delay
# time in seconds
delay=3

# keep_on_charge
# true|false
# keep powersave on while charging
keep_on_charge=true

# handle_cores
# auto|false|"cpu4 cpu5"
handle_cores=false

# disable_cores
# false|auto|"cpu6 cpu7"
disable_cores=false

# handle_apps
# false|kill|nice|suspend
handle_apps=false

# allowlist (user apps)
# a path /data/local/tmp/PowerSentinel/apps.allow
allowlist=/data/local/tmp/PowerSentinel/apps.allow

# denylist (system apps)
# a path /data/local/tmp/PowerSentinel/apps.deny
denylist=/data/local/tmp/PowerSentinel/apps.deny

# handle_gms
# false|kill|nice
handle_gms=false

# handle_proc
# true|false
handle_proc=false

# process list
# a path /data/local/tmp/PowerSentinel/proc.list
proc_file=/data/local/tmp/PowerSentinel/proc.list

# low_ram
# true|false
low_ram=false

# doze
# false|light|deep
doze=false

#kill_wifi
# true|false
kill_wifi=false

EOF

fi

# Bootstrap-only version check, reading $conf directly rather than
# through getconf/config_load_global - PowerSentinel.json doesn't exist
# yet at this point, so there's nothing for those to read. This is only
# ever used to decide whether the legacy v1->v2 text migration below
# needs to run; migrate_conf_to_json() further down builds the real
# JSON config everything else actually reads from, once $conf has
# settled into its final v2, block-structured form.
version="$(grep '^version=' "$conf" 2>/dev/null | tail -1 | cut -d= -f2)"
version="${version:-1}"

# check for a config without event blocks yet - covers both the
# bootstrap-created "version=2 but no blocks" transitional state AND a
# genuine, never-migrated v1 config (version=1 or no version= line at
# all). Previously this only fired for the former, requiring anyone
# actually still on v1 to manually add "version=2" to their file before
# ever getting auto-migrated - now any block-less config gets carried
# forward automatically, with no user action needed.
if [ "$(grep ".*={" "$conf" | head -n 1)" == "" ]; then
  # migrate() reads the user's current settings via getconf() to carry
  # them into the new block structure - but config_load_global() now
  # reads PowerSentinel.json, which doesn't exist yet at this point (this
  # whole branch only runs for someone still on the pre-block v1 flat
  # format). Populate PS_CONFIG directly from the old flat $conf just for
  # this one legacy step, so migrate()'s getconf calls see the user's
  # actual values instead of silently falling back to every default.
  PS_CONFIG=()
  while IFS=$'\t' read -r key value; do
    [ -n "$key" ] || continue
    PS_CONFIG["$key"]="$value"
  done < <(awk '
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      eq = index($0, "=")
      key = substr($0, 1, eq - 1)
      value = substr($0, eq + 1)
      print key "\t" value
    }
  ' "$conf")
  migrate
  version="$(grep '^version=' "$conf" 2>/dev/null | tail -1 | cut -d= -f2)"
  version="${version:-1}"
fi

# One-time upgrade path: convert the now-finalized $conf into
# PowerSentinel.json. No-op if PowerSentinel.json already exists (an
# already-migrated install, or a build tool created one directly) - see
# PowerSentinel-config.sh for the full rationale.
migrate_conf_to_json

# SECURITY FIX: none of the writers that create these files applied an
# explicit chmod until this version - mktemp's default mode depends on
# the process's umask, which turned out permissive enough in practice
# to leave PowerSentinel.json world-writable (666) on a real device (a
# user reported exactly this while helping test an unrelated issue).
# Every write path is now fixed to chmod 600 as it writes, but an
# ALREADY-existing file from before this fix stays wrongly-permissioned
# until something happens to rewrite it - which might not be for a
# while. Enforcing it unconditionally here, once per start, corrects
# any existing install immediately on its next restart rather than
# waiting for that.
for f in "$json_conf" "$state_file" "$journal_file"; do
  [ -e "$f" ] && chmod 600 "$f" 2>/dev/null
done

# Load the top-level configuration once, now from PowerSentinel.json.
# Event-specific values are read separately when their event is
# evaluated.
config_load_global
version="$(getconf version 1)"

# setup logging
log_file=$(getconf log_file "/sdcard/PowerSentinel.log")
log_level=$(getconf log_level 3) # set debug by default

# this fixes the infinite growth issue
[ -f "$log_file" ] && mv "$log_file" "$log_file.old"

# set ctl_file
#
# SECURITY: default lives inside /data/local/tmp/PowerSentinel/ (created below
# with normal root-owned permissions), not directly in /data/local/tmp
# itself. /data/local/tmp is world-writable (mode 1777) on Android, so a
# file placed straight in it can be pre-created by any unprivileged app
# before this daemon ever runs, letting that app keep read/write access
# to it (the sticky bit only stops others from deleting/renaming - not
# from creating a same-named file first). ensure_ctl_file() below also
# refuses to trust a pre-existing file it doesn't own, as defense in
# depth for anyone who has overridden ctl_file back into a shared path.
ctl_file=$(getconf ctl_file "/data/local/tmp/PowerSentinel/powersentinel")
ensure_ctl_file "$ctl_file"

# persistent safe mode
safe=$(getconf safemode false)
if [ "$safe" = "true" ]; then
  log_msg 1 "Safemode was found in the config file, Entering safemode."
  emit safemode critical "Safe Mode is Active"
  # BUG FIX: see the matching comment on the other safe-mode wait loop
  # above (the "safe" command handler) - same pre-existing, no-sleep
  # busy-spin bug, here too.
  until [ "$resume" = "resume" ] || [ "$(config_get safemode false)" = "false" ]; do
    sleep "$(getconf delay 3)"
    config_load_global
    resume=$(cat "$ctl_file")
  done
  config_set_global safemode false
  log_msg 1 "Safemode was exited. Restarting the daemon."
  exec "$0"
fi

delay=$(getconf delay 3)

# auto map cores in case we need them
auto_map_cores

# Find the rfkill command once and for all
find_rfkill_command

# Critical app protection: detect the device's default dialer/SMS/
# emergency apps and anything already exempted from battery
# optimization, so action_apps_apply/undo can protect them regardless
# of allowlist/denylist configuration.
detect_critical_apps

# Capability Manager: probe once what this device/ROM can actually do,
# so actions.sh can skip (with a clear log message) instead of blindly
# attempting something unsupported every single cycle. Runs after the
# two detections above since the rfkill_wifi capability depends on
# RFKILL_CMD already being set.
capabilities_detect

# By this point, every install has been migrated to v2 (see the
# widened migrate() trigger above) - v1 no longer has a code path at
# all. This check is a safety net, not a real branch: if version isn't
# "2" here, something upstream (migrate() or migrate_conf_to_json)
# failed unexpectedly, and refusing to run rather than silently
# misbehaving under an assumption that no longer holds is the safer
# failure mode.
if [ "$version" != "2" ]; then
  log_msg 1 "FATAL: could not migrate config to v2 (version=$version) - refusing to start"
  exit 1
fi

log_msg 1 "Starting PowerSentinel"
init_v2
