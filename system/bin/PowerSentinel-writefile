#!/system/bin/bash
# PowerSentinel-writefile <target-path>
#
# Reads base64-encoded content from stdin and writes it to <target-path>,
# used by the webroot frontend (via `kernelsu`'s exec()) instead of a raw
# shell redirect, so that:
#
#   1. Arbitrary file content is never interpolated into a shell command
#      line - it travels as base64 and is decoded server-side.
#   2. Only PowerSentinel's own data directory can be written.
#   3. The write is atomic (temp file + mv) and keeps one .bak of the
#      previous content.

set -u

TARGET="${1:-}"
ALLOWED_DIR="/data/local/tmp/PowerSentinel"

fail() { echo "PowerSentinel-writefile: $1" >&2; exit 1; }

[ -n "$TARGET" ] || fail "missing target path"
case "$TARGET" in
  "$ALLOWED_DIR"/*) ;;
  *) fail "target not allowed: $TARGET" ;;
esac
case "$TARGET" in
  *..*) fail "path traversal rejected: $TARGET" ;;
esac
[ -L "$TARGET" ] && fail "refusing to write through a symlink: $TARGET"

mkdir -p "$ALLOWED_DIR" 2>/dev/null

TMP_FILE="${TARGET}.tmp.$$"
if ! base64 -d > "$TMP_FILE" 2>/dev/null; then
  rm -f "$TMP_FILE"
  fail "failed to decode incoming content"
fi

if [ -f "$TARGET" ]; then
  cp -f "$TARGET" "${TARGET}.bak" 2>/dev/null
fi

chmod 0644 "$TMP_FILE" 2>/dev/null
mv -f "$TMP_FILE" "$TARGET" || fail "failed to move into place"

echo "OK"
