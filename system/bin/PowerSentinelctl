#!/system/bin/bash

conf="/data/local/tmp/PowerSentinel/PowerSentinel.conf"

getconf() {
  opt=$(grep "^$1=" "$conf" | cut -d= -f2)
  [ "$opt" != "" ] && echo "$opt" || echo "$2"
}

# Keep the control file in PowerSentinel's private data directory and repair
# it if an untrusted process pre-created it. The daemon performs the same
# ownership check before consuming commands.
ensure_ctl_file() {
  local f="$1"
  local owner
  mkdir -p "$(dirname "$f")" 2>/dev/null
  if [ -e "$f" ]; then
    owner="$(stat -c '%u' "$f" 2>/dev/null)"
    if [ "$owner" != "0" ]; then
      rm -f "$f"
    fi
  fi
  [ -e "$f" ] || : > "$f"
  chmod 600 "$f" 2>/dev/null
}

ctl_file=$(getconf ctl_file "/data/local/tmp/PowerSentinel/powersentinel")
ensure_ctl_file "$ctl_file"
version=$(getconf version 1)

print_help_v2() {
cat << EOM
  PowerSentinel Controller Options:

  start		starts the manual event or a custom event
  stop		stops the manual event or a custom event
  pause		pauses the PowerSentinel daemon
  resume	resumes the PowerSentinel daemon or exits safe mode
  safe		stops all events and enters safe mode
EOM
}

print_help_v1() {
cat << EOM
  PowerSentinel Controller Options:

  start		enables power save mode manually.
  stop		disables power save mode manually.
  reload	reloads the config file.
  pause		pauses the daemon.
  resume	resumes the daemon or exits Safe Mode.
  safe		Enters Safe Mode.
EOM
}

case "${1:-}" in
  ''|'-h'|'--help')
    if [ "$version" = 2 ]; then
      print_help_v2
    else
      print_help_v1
    fi
    ;;
  *)
    # The daemon consumes a small text command protocol. Reject shell
    # metacharacters, option-like arguments and excessive argument counts
    # before anything reaches the control file. This preserves custom event
    # names while preventing the CLI from becoming a shell-command tunnel.
    if [ "$#" -gt 2 ]; then
      echo "PowerSentinelctl: too many arguments" >&2
      exit 2
    fi
    for arg in "$@"; do
      case "$arg" in
        ''|-[!-]*|*[!a-zA-Z0-9_.:-]*)
          echo "PowerSentinelctl: invalid argument" >&2
          exit 2
          ;;
      esac
    done

    if [[ "$1" = "start" || "$1" = "stop" ]] && [ "$version" = "2" ] && [ "$#" -eq 1 ]; then
      echo "start manual" > "$ctl_file"
    else
      printf '%s\n' "$*" > "$ctl_file"
    fi
    ;;
esac
