#!/system/bin/bash

# CRITICAL FIX (found during a full-codebase audit): getconf() used to
# read the .conf text file directly - but the daemon has read
# PowerSentinel.json exclusively since v3.10.0. In the common case
# (default ctl_file path) this happened to still work by coincidence,
# since the default hardcoded here matched the daemon's own default -
# but a user who customized ctl_file via the WebUI (writing to JSON)
# would have this tool silently keep using the stale default from the
# frozen .conf, writing commands to a file the daemon isn't watching.
json_conf="/data/local/tmp/PowerSentinel/PowerSentinel.json"
JQ="$(dirname "$0")/jq"

getconf() {
  local value
  value="$("$JQ" -r --arg k "$1" '.global[$k]? // empty' "$json_conf" 2>/dev/null)"
  [ -n "$value" ] && echo "$value" || echo "$2"
}

# Keep the control file in PowerSentinel's private data directory and repair
# it if an untrusted process pre-created it. The daemon performs the same
# ownership check before consuming commands.
ensure_ctl_file() {
  local f="$1"
  local owner
  mkdir -p "$(dirname "$f")" 2>/dev/null
  if [ -e "$f" ]; then
    owner="$(stat -c '%u' "$f" 2>/dev/null)"
    if [ "$owner" != "0" ]; then
      rm -f "$f"
    fi
  fi
  [ -e "$f" ] || : > "$f"
  chmod 600 "$f" 2>/dev/null
}

ctl_file=$(getconf ctl_file "/data/local/tmp/PowerSentinel/powersentinel")
ensure_ctl_file "$ctl_file"

# v1 support has been removed from the daemon entirely (every install
# auto-migrates to v2 on first boot) - the version-dependent help text
# and command-format branching this used to have are gone; there's only
# ever one behavior now.
print_help() {
cat << EOM
  PowerSentinel Controller Options:

  start\t\tstarts the manual event or a custom event
  stop\t\tstops the manual event or a custom event
  pause\t\tpauses the PowerSentinel daemon
  resume\tresumes the PowerSentinel daemon or exits safe mode
  safe\t\tstops all events and enters safe mode
EOM
}

case "${1:-}" in
  ''|'-h'|'--help')
    print_help
    ;;
  *)
    # The daemon consumes a small text command protocol. Reject shell
    # metacharacters, option-like arguments and excessive argument counts
    # before anything reaches the control file. This preserves custom event
    # names while preventing the CLI from becoming a shell-command tunnel.
    if [ "$#" -gt 2 ]; then
      echo "PowerSentinelctl: too many arguments" >&2
      exit 2
    fi
    for arg in "$@"; do
      case "$arg" in
        ''|-[!-]*|*[!a-zA-Z0-9_.:-]*)
          echo "PowerSentinelctl: invalid argument" >&2
          exit 2
          ;;
      esac
    done

    if [[ "$1" = "start" || "$1" = "stop" ]] && [ "$#" -eq 1 ]; then
      echo "start manual" > "$ctl_file"
    else
      printf '%s\n' "$*" > "$ctl_file"
    fi
    ;;
esac
