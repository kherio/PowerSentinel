#!/system/bin/bash
# PowerSentinel-appdrain - one-shot, on-demand ranking of how much
# battery each app used, from Android's own battery statistics
# (`dumpsys batterystats`, the "UID ..." lines under "Estimated power
# use"). Purely informational: it never changes anything on the device
# and nothing feeds from it into any automatic decision (same contract as
# PowerSentinel-cpurank/-wakeups).
#
# Usage:
#   PowerSentinel-appdrain snapshot   save the current per-app totals
#   PowerSentinel-appdrain report     what each app used since the
#                                     snapshot; with no snapshot, since
#                                     the last full charge (whatever
#                                     Android's statistics cover)
#
# The snapshot is a DIFF baseline kept in our own file - the system
# statistics are never reset, so Android's own battery screen is not
# affected (unlike resetting the system statistics).
#
# The numbers are Android's ESTIMATES in mAh (power-profile model), good
# for comparing apps with each other, not a physical measurement. Only
# regular apps (uid uNNaMMM) are mapped to packages; system uids (0, 1000,
# ...) are skipped. Packages sharing one uid share one number ("shared").
#
# Output is ONE line of JSON:
#   {"available":true,"window":"snapshot"|"charge","since":EPOCH,
#    "elapsed_s":N,"apps":[{"pkg":"...","mah":1.23,"fg":..,"bg":..,
#    "cached":..,"shared":1}, ...]}
# sorted by mah, top 60, apps under 0.1 mAh omitted.

STATE="${APPDRAIN_STATE:-/data/local/tmp/PowerSentinel/PowerSentinel.appdrain_snapshot}"

_unavailable() { echo '{"available":false,"window":"charge","since":0,"elapsed_s":0,"apps":[]}'; }

# uid<TAB>total<TAB>fg<TAB>bg<TAB>cached, one line per app uid (highest
# value wins if a uid is listed twice in the dump).
_read_uids() {
  local dump
  if [ -n "$APPDRAIN_STATS_FILE" ]; then dump="$(cat "$APPDRAIN_STATS_FILE" 2>/dev/null)"
  else dump="$(dumpsys batterystats 2>/dev/null)"; fi
  printf '%s\n' "$dump" | awk '
    $1 == "UID" {
      name = $2; sub(/:$/, "", name)
      if (name !~ /^u[0-9]+a[0-9]+$/) next
      user = name; sub(/^u/, "", user); sub(/a.*$/, "", user)
      app = name; sub(/^u[0-9]+a/, "", app)
      uid = user * 100000 + 10000 + app
      total = $3 + 0; fg = 0; bg = 0; ca = 0
      for (i = 4; i < NF; i++) {
        if ($i == "fg:") fg = $(i+1) + 0
        else if ($i == "bg:") bg = $(i+1) + 0
        else if ($i == "cached:") ca = $(i+1) + 0
      }
      if (!(uid in T) || total > T[uid]) { T[uid] = total; F[uid] = fg; B[uid] = bg; C[uid] = ca }
    }
    END { for (u in T) printf "%s\t%.4f\t%.4f\t%.4f\t%.4f\n", u, T[u], F[u], B[u], C[u] }'
}

# uid<TAB>package, from `pm list packages -U` ("package:NAME uid:N").
_read_pkgs() {
  if [ -n "$APPDRAIN_PKG_FILE" ]; then cat "$APPDRAIN_PKG_FILE" 2>/dev/null
  else pm list packages -U 2>/dev/null; fi | awk '
    /^package:/ {
      p = $1; sub(/^package:/, "", p)
      u = $2; sub(/^uid:/, "", u)
      if (p ~ /^[A-Za-z0-9._]+$/ && u ~ /^[0-9]+$/) print u "\t" p
    }'
}

case "$1" in
  snapshot)
    cur="$(_read_uids)"
    [ -n "$cur" ] || { _unavailable; exit 0; }
    mkdir -p "$(dirname "$STATE")" 2>/dev/null
    { date +%s; printf '%s\n' "$cur"; } > "$STATE" 2>/dev/null
    chmod 600 "$STATE" 2>/dev/null
    echo "{\"available\":true,\"window\":\"snapshot\",\"since\":$(head -n1 "$STATE"),\"elapsed_s\":0,\"apps\":[]}"
    ;;
  report|"")
    cur="$(_read_uids)"
    [ -n "$cur" ] || { _unavailable; exit 0; }
    now="$(date +%s)"
    since=0; window=charge; base=""
    if [ -s "$STATE" ]; then
      since="$(head -n1 "$STATE")"
      case "$since" in ''|*[!0-9]*) since=0 ;; esac
      if [ "$since" -gt 0 ]; then window=snapshot; base="$(tail -n +2 "$STATE")"; fi
    fi
    elapsed=0; [ "$since" -gt 0 ] && elapsed=$(( now - since ))
    pkgs="$(_read_pkgs)"
    # Fields: first stream = packages, second = baseline, third = current.
    printf '%s\n--B--\n%s\n--C--\n%s\n' "$pkgs" "$base" "$cur" | awk -F'\t' -v window="$window" -v since="$since" -v elapsed="$elapsed" '
      /^--B--$/ { mode = "b"; next }
      /^--C--$/ { mode = "c"; next }
      mode == "" && NF == 2 { n[$1]++; pk[$1, n[$1]] = $2; next }
      mode == "b" && NF >= 5 { BT[$1] = $2; BF[$1] = $3; BB[$1] = $4; BC[$1] = $5; next }
      mode == "c" && NF >= 5 { CT[$1] = $2; CF[$1] = $3; CB[$1] = $4; CC[$1] = $5; next }
      END {
        cnt = 0
        for (u in CT) {
          t = CT[u]; f = CF[u]; b = CB[u]; c = CC[u]
          if (u in BT && CT[u] >= BT[u]) { t -= BT[u]; f -= BF[u]; b -= BB[u]; c -= BC[u] }
          if (f < 0) f = 0; if (b < 0) b = 0; if (c < 0) c = 0
          if (t < 0.1 || !(u in n)) continue
          for (i = 1; i <= n[u]; i++) { cnt++; P[cnt] = pk[u, i]; M[cnt] = t; FF[cnt] = f; BBB[cnt] = b; CCC[cnt] = c; S[cnt] = n[u] }
        }
        # selection sort of the top 60 by mah, descending
        lim = cnt < 60 ? cnt : 60
        for (i = 1; i <= lim; i++) {
          best = i
          for (j = i + 1; j <= cnt; j++) if (M[j] > M[best]) best = j
          if (best != i) {
            x = P[i]; P[i] = P[best]; P[best] = x
            x = M[i]; M[i] = M[best]; M[best] = x
            x = FF[i]; FF[i] = FF[best]; FF[best] = x
            x = BBB[i]; BBB[i] = BBB[best]; BBB[best] = x
            x = CCC[i]; CCC[i] = CCC[best]; CCC[best] = x
            x = S[i]; S[i] = S[best]; S[best] = x
          }
        }
        out = "{\"available\":true,\"window\":\"" window "\",\"since\":" since ",\"elapsed_s\":" elapsed ",\"apps\":["
        for (i = 1; i <= lim; i++) {
          out = out (i > 1 ? "," : "") sprintf("{\"pkg\":\"%s\",\"mah\":%.2f,\"fg\":%.2f,\"bg\":%.2f,\"cached\":%.2f,\"shared\":%d}", P[i], M[i], FF[i], BBB[i], CCC[i], S[i])
        }
        print out "]}"
      }'
    ;;
  *) echo "usage: PowerSentinel-appdrain snapshot|report" >&2; exit 2 ;;
esac
