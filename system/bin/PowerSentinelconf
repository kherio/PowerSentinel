#!/system/bin/bash
# PowerSentinelconf - terminal-based configurator for PowerSentinel.
#
# CRITICAL FIX (found during a full-codebase audit): this tool used to
# read/write PowerSentinel.conf directly - but the daemon has read
# PowerSentinel.json exclusively since v3.10.0 ($conf is migrated once,
# then never read again - see PowerSentinel-config.sh). Every get/set/
# add-event/rm-event command run through this tool since v3.10.0 wrote
# to a file the daemon no longer looked at, silently having zero effect
# on actual behavior. Rewritten to operate on the real JSON config via
# jq, mirroring the exact same access pattern PowerSentinel-config.sh
# uses (temp file + atomic rename for every write). Also drops the
# wizard's old "v1 · Simple (heredado)" choice, since v1 support was
# removed from the daemon entirely.
#
# Meant to be run as root:
#   su -c PowerSentinelconf              # from ADB or a terminal emulator (Termux, etc.)
#   PowerSentinelconf                    # if already in a root shell
#
# Usage:
#   PowerSentinelconf              interactive wizard, (re)writes the whole config
#   PowerSentinelconf show         print the current effective settings
#   PowerSentinelconf get KEY [--event NAME]
#   PowerSentinelconf set KEY VAL [--event NAME]
#   PowerSentinelconf events                       list configured events
#   PowerSentinelconf add-event NAME               add an empty event block
#   PowerSentinelconf rm-event NAME                remove an event block

CONF_DIR="/data/local/tmp/PowerSentinel"
JSON_CONF="$CONF_DIR/PowerSentinel.json"
JQ="$(dirname "$0")/jq"

PREDEFINED_EVENTS="boot charging screen_off low_power night thermal adaptive_tier1 adaptive_tier2 adaptive_tier3 manual"

require_root() {
  if [ "$(id -u 2>/dev/null)" != "0" ]; then
    echo "PowerSentinelconf necesita permisos de root. Prueba: su -c PowerSentinelconf" >&2
    exit 1
  fi
}

ensure_conf() {
  mkdir -p "$CONF_DIR"
  if [ ! -s "$JSON_CONF" ]; then
    echo '{"global":{},"events":{}}' > "$JSON_CONF"
    chmod 600 "$JSON_CONF" 2>/dev/null
  fi
}

backup_conf() {
  [ -f "$JSON_CONF" ] && cp "$JSON_CONF" "$JSON_CONF.bak" 2>/dev/null
}

# Runs a jq filter against $JSON_CONF and atomically replaces it with the
# result - every write in this file goes through this one function, so
# there's exactly one place that knows how to do it safely (temp file +
# validate + atomic rename, same pattern PowerSentinel-config.sh uses).
# A jq failure (bad filter, unreadable input) leaves $JSON_CONF
# completely untouched rather than risking a partial/corrupt write.
apply_jq() {
  local tmp
  tmp="$(mktemp "$CONF_DIR/.PowerSentinel.json.XXXXXX")" || { echo "No se pudo crear un fichero temporal." >&2; return 1; }
  if "$JQ" "$@" "$JSON_CONF" > "$tmp" 2>/dev/null && [ -s "$tmp" ] && "$JQ" -e . "$tmp" >/dev/null 2>&1; then
    chmod 600 "$tmp" 2>/dev/null
    mv "$tmp" "$JSON_CONF"
    return 0
  fi
  rm -f "$tmp"
  echo "Error al escribir la configuración (¿falló jq?)." >&2
  return 1
}

# ---------- low-level read/write on the real JSON config ----------

# getval KEY [EVENT] -> prints the value or empty, exit 1 if not found
getval() {
  local key="$1" event="$2" value
  if [ -z "$event" ]; then
    value="$("$JQ" -r --arg k "$key" '.global[$k]? // empty' "$JSON_CONF" 2>/dev/null)"
  else
    value="$("$JQ" -r --arg e "$event" --arg k "$key" '.events[$e][$k]? // empty' "$JSON_CONF" 2>/dev/null)"
  fi
  [ -n "$value" ] || return 1
  printf '%s\n' "$value"
}

# setval KEY VALUE [EVENT] -> creates the global key or event block if needed
setval() {
  local key="$1" val="$2" event="$3"
  backup_conf
  if [ -z "$event" ]; then
    apply_jq --arg k "$key" --arg v "$val" '.global[$k] = $v'
  else
    apply_jq --arg e "$event" --arg k "$key" --arg v "$val" \
      '.events[$e] = ((.events[$e] // {}) + {($k): $v})'
  fi
}

list_events() {
  "$JQ" -r '.events // {} | keys[]' "$JSON_CONF" 2>/dev/null
}

add_event() {
  local name="$1"
  name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
  [ -z "$name" ] && { echo "Nombre de evento no válido."; return 1; }
  if "$JQ" -e --arg e "$name" '.events | has($e)' "$JSON_CONF" >/dev/null 2>&1; then
    echo "El evento '$name' ya existe."; return 1
  fi
  backup_conf
  apply_jq --arg e "$name" '.events[$e] = {}' && echo "Evento '$name' añadido."
}

rm_event() {
  local name="$1"
  backup_conf
  apply_jq --arg e "$name" 'del(.events[$e])' && echo "Evento '$name' eliminado (si existía)."
}

# ---------- interactive prompts ----------

ask() {
  # ask "Pregunta" "valor_por_defecto"
  local prompt="$1" def="$2" ans
  read -rp "$prompt [$def]: " ans
  echo "${ans:-$def}"
}

ask_choice() {
  # ask_choice "Pregunta" "def" "value:Label" "value:Label" ...
  local prompt="$1" def="$2"; shift 2
  local opts=("$@") i=1 line val lab
  echo "$prompt" >&2
  for line in "${opts[@]}"; do
    val="${line%%:*}"; lab="${line#*:}"
    local mark=""
    [ "$val" = "$def" ] && mark="  (actual: $def)"
    printf '  %d) %s%s\n' "$i" "$lab" "$mark" >&2
    i=$((i+1))
  done
  local choice
  read -rp "Elige [1-$((i-1)), enter = mantener actual]: " choice
  if [ -z "$choice" ]; then echo "$def"; return; fi
  local sel="${opts[$((choice-1))]}"
  echo "${sel%%:*}"
}

ask_yesno() {
  local prompt="$1" def="$2" ans
  local defLabel="s/N"; [ "$def" = "true" ] && defLabel="S/n"
  read -rp "$prompt [$defLabel]: " ans
  case "$ans" in
    s|S|si|Si|SI|y|Y) echo "true" ;;
    n|N|no|No|NO) echo "false" ;;
    '') echo "$def" ;;
    *) echo "$def" ;;
  esac
}

# Prompts for the shared event field set. Prints one "key=value" per
# line (only non-empty), to be captured by the caller and merged into
# the event's JSON object one key at a time via apply_jq.
prompt_fields() {
  local ctx="$1"   # label for messages, e.g. "screen_off"
  echo >&2
  echo "--- $ctx ---" >&2

  local handle_apps
  handle_apps=$(ask_choice "Gestión de apps" "false" \
    "false:No gestionar" "kill:Matar (kill)" "nice:Reducir prioridad (nice)" "suspend:Suspender")
  echo "handle_apps=$handle_apps"
  if [ "$handle_apps" = "suspend" ]; then
    echo "allowlist=$(ask 'Ruta de la allowlist' "$CONF_DIR/apps.allow")"
  fi
  echo "denylist=$(ask 'Ruta de la denylist (apps del sistema)' "$CONF_DIR/apps.deny")"

  local cores
  cores=$(ask_choice "Núcleos en modo ahorro (handle_cores)" "false" \
    "false:Desactivado" "auto:Automático" "custom:Personalizado")
  if [ "$cores" = "custom" ]; then
    cores=$(ask "Núcleos separados por espacio (ej: cpu4 cpu5)" "")
  fi
  echo "handle_cores=$cores"

  local dcores
  dcores=$(ask_choice "Núcleos a desactivar (disable_cores) — ¡evitar en Samsung!" "false" \
    "false:Desactivado" "auto:Automático" "custom:Personalizado")
  if [ "$dcores" = "custom" ]; then
    dcores=$(ask "Núcleos separados por espacio (ej: cpu6 cpu7)" "")
  fi
  echo "disable_cores=$dcores"

  echo "handle_gms=$(ask_choice 'Google Mobile Services' 'false' \
    'false:No gestionar' 'nice:Reducir prioridad' 'kill:Matar (rompe SafetyNet)')"

  local hproc
  hproc=$(ask_yesno "¿Reprocesar prioridad de procesos (handle_proc)?" "false")
  echo "handle_proc=$hproc"
  if [ "$hproc" = "true" ]; then
    echo "proc_file=$(ask 'Ruta del archivo de procesos' "$CONF_DIR/proc.list")"
  fi

  echo "low_ram=$(ask_yesno '¿Modo RAM baja? (puede causar reinicios en OnePlus)' 'false')"
  echo "doze=$(ask_choice 'Forzar Doze (puede retrasar alarmas)' 'false' \
    'false:Desactivado' 'light:Ligero' 'deep:Profundo')"
  echo "kill_wifi=$(ask_yesno '¿Desactivar WiFi?' 'false')"
  echo "keep_on_charge=$(ask_yesno '¿Mantener ajustes mientras carga?' 'true')"
}

# Merges "key=value" lines (as produced by prompt_fields) into the given
# event's JSON object, one apply_jq call per key - simplest way to reuse
# prompt_fields' existing line-based output without teaching it about
# JSON directly.
save_fields_to_event() {
  local event="$1" fields="$2" k v
  while IFS='=' read -r k v; do
    [ -n "$k" ] || continue
    apply_jq --arg e "$event" --arg k "$k" --arg v "$v" \
      '.events[$e] = ((.events[$e] // {}) + {($k): $v})'
  done <<< "$fields"
}

wizard() {
  echo "=== Asistente de configuración de PowerSentinel ==="
  echo "Este asistente reescribe $JSON_CONF por completo."
  [ -s "$JSON_CONF" ] && echo "(Se guardará una copia de seguridad en $JSON_CONF.bak)"
  echo

  local delay log_file log_level notify
  delay=$(ask "Intervalo de sondeo en segundos (delay)" "3")
  log_file=$(ask "Archivo de log" "/sdcard/PowerSentinel.log")
  log_level=$(ask_choice "Nivel de log" "2" "1:INFO" "2:VERBOSE" "3:DEBUG")
  notify=$(ask_yesno "¿Mostrar notificaciones?" "true")

  backup_conf
  "$JQ" -n --arg delay "$delay" --arg log_file "$log_file" --arg log_level "$log_level" --arg notify "$notify" \
    '{global: {version: "2", delay: $delay, log_file: $log_file, log_level: $log_level, notify: $notify}, events: {}}' \
    > "$JSON_CONF"
  chmod 600 "$JSON_CONF" 2>/dev/null

  echo
  echo "Ahora vamos a definir los eventos (screen_off, low_power, boot, etc)."
  echo "Puedes añadir tantos como quieras, incluidos personalizados."
  while true; do
    echo
    echo "Eventos predefinidos disponibles: $PREDEFINED_EVENTS"
    local name
    read -rp "Nombre del evento a añadir (vacío para terminar): " name
    [ -z "$name" ] && break
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_-')
    [ -z "$name" ] && { echo "Nombre no válido, usa letras/números/_/-"; continue; }

    apply_jq --arg e "$name" '.events[$e] = ((.events[$e]) // {})'
    save_fields_to_event "$name" "$(prompt_fields "$name")"
    echo "Evento '$name' guardado."
  done

  echo
  echo "Configuración escrita en $JSON_CONF"
  echo "Aplica los cambios con: su -c 'PowerSentinelctl reload'  (o reinicia el dispositivo)"
}

# ---------- entry point ----------

require_root
ensure_conf

case "$1" in
  '')
    wizard
    ;;
  show)
    "$JQ" . "$JSON_CONF" 2>/dev/null || cat "$JSON_CONF"
    ;;
  get)
    shift
    key="$1"; shift
    event=""
    [ "$1" = "--event" ] && event="$2"
    getval "$key" "$event"
    ;;
  set)
    shift
    key="$1"; val="$2"; shift 2
    event=""
    [ "$1" = "--event" ] && event="$2"
    if [ -z "$key" ] || [ -z "$val" ]; then
      echo "Uso: PowerSentinelconf set KEY VALOR [--event NOMBRE]" >&2
      exit 1
    fi
    setval "$key" "$val" "$event" && echo "$key=$val actualizado$( [ -n "$event" ] && echo " en el evento $event" )."
    ;;
  events)
    list_events
    ;;
  add-event)
    add_event "$2"
    ;;
  rm-event)
    rm_event "$2"
    ;;
  -h|--help)
    sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Comando desconocido: $1" >&2
    echo "Ejecuta 'PowerSentinelconf -h' para ver el uso." >&2
    exit 1
    ;;
esac
